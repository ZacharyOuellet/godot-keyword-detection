[configuration]
entry_symbol = "mfcc_dtw_library_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://addons/mfcc_dtw/bin/mfcc_dtw.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/mfcc_dtw/bin/mfcc_dtw.linux.template_release.x86_64.so"

windows.debug.x86_64   = "res://addons/mfcc_dtw/bin/mfcc_dtw.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mfcc_dtw/bin/mfcc_dtw.windows.template_release.x86_64.dll"

macos.debug   = "res://addons/mfcc_dtw/bin/fcc_dtw.macos.template_debug.universal.dylib"
macos.release = "res://addons/mfcc_dtw/bin/fcc_dtw.macos.template_release.universal.dylib"
