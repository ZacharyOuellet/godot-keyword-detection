[configuration]

entry_symbol = "godot_keyword_detection_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "./macos/libgodot_keyword_detection.macos.template_debug.dylib"
macos.single.release = "./macos/libgodot_keyword_detection.macos.template_release.dylib"

ios.arm64.single.debug = "./ios/libgodot_keyword_detection.ios.template_debug.arm64.dylib"
ios.arm64.single.release = "./ios/libgodot_keyword_detection.ios.template_release.arm64.dylib"

windows.x86_32.single.debug = "./windows/godot_keyword_detection.windows.template_debug.x86_32.dll"
windows.x86_32.single.release = "./windows/godot_keyword_detection.windows.template_release.x86_32.dll"

windows.x86_64.single.debug = "./windows/godot_keyword_detection.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "./windows/godot_keyword_detection.windows.template_release.x86_64.dll"

linux.x86_64.single.debug = "./linux/libgodot_keyword_detection.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./linux/libgodot_keyword_detection.linux.template_release.x86_64.so"

linux.arm64.single.debug = "./linux/libgodot_keyword_detection.linux.template_debug.arm64.so"
linux.arm64.single.release = "./linux/libgodot_keyword_detection.linux.template_release.arm64.so"

linux.rv64.single.debug = "./linux/libgodot_keyword_detection.linux.template_debug.rv64.so"
linux.rv64.single.release = "./linux/libgodot_keyword_detection.linux.template_release.rv64.so"

android.x86_64.single.debug = "./android/libgodot_keyword_detection.android.template_debug.x86_64.so"
android.x86_64.single.release = "./android/libgodot_keyword_detection.android.template_release.x86_64.so"

android.arm64.single.debug = "./android/libgodot_keyword_detection.android.template_debug.arm64.so"
android.arm64.single.release = "./android/libgodot_keyword_detection.android.template_release.arm64.so"

web.wasm32.single.debug = "./web/libgodot_keyword_detection.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.single.release = "./web/libgodot_keyword_detection.web.template_release.wasm32.nothreads.wasm"
