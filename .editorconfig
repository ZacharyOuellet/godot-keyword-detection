root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4

[*.gd]
indent_style = tab

[*.xml]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[{*.cmake,CMakeLists.txt}]
indent_style = space
ij_continuation_indent_size = 4
ij_cmake_force_commands_case = 1

